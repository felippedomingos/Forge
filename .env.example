# Copy this file to .env and fill it in, then `docker compose up -d`.
# See README.md for the full walkthrough and docs/015-Deployment.md for what each
# service does. Nothing in docker-compose.yml defaults to a path on the founder's own
# machine - every value below is meant to be filled in by whoever is running this.

# --- Postgres (shared by forge-api's `forge` schema and Temporal's own auto-setup) ---
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_local_dev
POSTGRES_DB=forge

# --- Ports exposed on your host machine ---
POSTGRES_PORT=5432
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
FORGE_API_PORT=5080
FRONTEND_PORT=5173

# --- Forge.Api (docs/adr/ADR-0006) ---
# Signs every JWT this API issues. REQUIRED - generate a real secret, e.g.:
#   openssl rand -base64 48
FORGE_JWT_SECRET=

# Origin allowed to call forge-api's CORS policy directly (browser -> API, bypassing
# the frontend's nginx /api proxy). Only matters if you hit the API from somewhere
# other than the bundled frontend container; safe to leave at the default below.
FORGE_CORS_ORIGIN=http://localhost:5173

# --- Forge.Worker (docs/005-Agents.md, docs/adr/ADR-0005) ---

# In-container path where the Worker checks out task branches (AgentActivities.
# WorktreesRootDir) - backed by the forge_worktrees_data named volume, so the default
# below is fine as-is unless you specifically want it somewhere else in the container.
FORGE_WORKTREES_DIR=/data/forge-worktrees

# Host directory holding the canonical checkouts of the repos you'll add as Forge
# Projects. Mounted into forge-worker at /data/repos - when creating a Project via the
# UI, set its LocalPath to /data/repos/<your-repo-folder-name> (the in-container path,
# not this host path).
FORGE_REPOS_DIR=./data/repos

# GitHub PAT for the `gh` CLI (GitOps.RunGhAsync - `gh pr create`/`gh pr view`).
# Needs `repo` scope. Generate one at https://github.com/settings/tokens - gh reads
# GH_TOKEN natively, no `gh auth login` device flow needed inside the container.
GH_TOKEN=

# Azure DevOps PAT for the `az` CLI's azure-devops extension (GitOps.RunAzAsync -
# `az repos pr create`/`pr show`), only needed if any Project uses an Azure Repos
# RepositoryUrl. Generate one from your Azure DevOps org's User Settings > Personal
# Access Tokens (Code: Read & Write scope). Recognized natively by the azure-devops
# extension - no `az login` needed inside the container.
AZURE_DEVOPS_EXT_PAT=

# Host directory holding an *already logged-in* Claude Code CLI config
# (docs/adr/ADR-0005: OAuth via your Claude.ai subscription, not an API key - there is
# no env var that hands the container a fresh login). Run `claude` interactively on
# your host first (or on any machine) to produce this directory, then point this at
# it as an ABSOLUTE path - Compose does not expand `~` in .env values. Mounted into
# forge-worker at /root/.claude. Left unset, the Worker starts fine (so the rest of
# the stack - board, API, everything short of an actual agent run - works with zero
# Claude setup) but any Planner/Developer/Deploy activity will fail until this points
# at a real login.
#   macOS/Linux default location: $HOME/.claude, e.g. /home/yourname/.claude
CLAUDE_CONFIG_DIR_HOST=/home/yourname/.claude

# Optional multi-account failover (docs/adr/ADR-0005 - founder-requested 2026-08-08):
# colon-separated CLAUDE_CONFIG_DIR paths, each one an account you've already
# completed an interactive login against (`CLAUDE_CONFIG_DIR=/some/path claude` then
# `/login`). On a detected usage-limit failure, the Worker rotates to the next
# available account instead of failing outright. Leave unset for today's single-
# account behavior (CLAUDE_CONFIG_DIR_HOST above, unaffected).
# Containerized deployment note: each path here must be reachable INSIDE
# forge-worker, not just on the host - the single CLAUDE_CONFIG_DIR_HOST mount above
# only wires up one account; a second account needs its own `- host/path:/container/path`
# volume line added to forge-worker in docker-compose.yml, with the container-side
# path listed here (not the host path).
# CLAUDE_ACCOUNT_CONFIG_DIRS=/home/yourname/.claude:/home/yourname/.claude-account-2
